<html>
  <head>
    <link rel="stylesheet" href="/styles.css" />
    <title>Form</title>
  </head>
  <body>
    <form method="POST" action="/new">
      <label for="messageUser">Name</label>
      <input type="text" id="messageUser" name="messageUser" required />
      <label for="messageText">Message</label>
      <textarea
        id="messageText"
        name="messageText"
        rows="5"
        cols="50"
        required
      ></textarea>
      <button type="submit">Send</button>
    </form>
  </body>
</html>
